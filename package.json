{
  "name": "investment-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "South African savings and investment planner: monthly compounding in integer cents, contribution escalation, fees, inflation-adjusted values, tax-free savings limits and a goal solver.",
  "license": "MIT",
  "author": "Admire T. Ndaneta",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
